{
  // Type-checks host/**/*.ts (ExtendScript for After Effects) with TypeScript 7. Types: After Effects 22.0 (the manifest
  // minimum) and the ES3 standard library from types-for-adobe, so ES5+ runtime APIs (map, forEach, JSON...) are
  // compile errors. Modern syntax (const, arrows, template strings) is fine: tsconfig.host-emit.json lowers it to ES5
  // (TypeScript 5.9, which can still emit ES5); test/static-checks.ts lints the output. scripts/build-host.ts joins it
  // with the remaining host/**/*.jsx into panel/host/host.jsx.
  "compilerOptions": {
    "target": "ES2015",
    "module": "preserve",
    "noLib": true,
    "typeRoots": [],
    "types": [],
    "strict": true,
    "allowJs": true,
    "checkJs": false,
    "outDir": "build/host",
    "noEmit": true,
    "rootDir": "host",
    "newLine": "lf",
    "skipLibCheck": true
  },
  "files": ["node_modules/types-for-adobe/AfterEffects/22.0/index.d.ts"],
  "include": ["host/**/*.ts", "host/**/*.jsx"]
}
